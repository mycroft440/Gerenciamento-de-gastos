PORT=8080
DEPLOYMENT_MODE=personal
BELVO_BASE_URL=https://sandbox.belvo.com
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_TIMEOUT_MS=20000
BELVO_STALE_DAYS=90

# Metadados persistentes de readiness/webhooks; não armazena CPF nem extratos.
STATE_DB_PATH=./data/openfinance.sqlite

# Segurança do app/backend. O modo atual é pessoal: um único código de acesso.
APP_ACCESS_CODE=
SESSION_SIGNING_KEY=
SESSION_TTL_SECONDS=900
AUTH_MAX_ATTEMPTS=5
AUTH_WINDOW_MS=300000

# Configure este mesmo valor como Authorization: Bearer no webhook da Belvo.
BELVO_WEBHOOK_AUTH_TOKEN=

COMPANY_NAME=Gerenciamento de Gastos
COMPANY_ICON_URL=https://seu-dominio.com/icon.svg
COMPANY_LOGO_URL=https://seu-dominio.com/logo.svg
TERMS_URL=https://seu-dominio.com/termos
CONSENT_PURPOSE=Consolidar suas contas, receitas e despesas para exibir um painel pessoal de gerenciamento financeiro.

# Deep links são adequados ao MVP pessoal. Para distribuição pública, migre para App Links HTTPS verificados.
CALLBACK_SUCCESS=gerenciamentogastos://success
CALLBACK_EXIT=gerenciamentogastos://exit
CALLBACK_EVENT=gerenciamentogastos://error
